{
  "name": "@suggix/widget",
  "version": "1.0.0",
  "description": "The official embeddable feedback, roadmap, and changelog widget for Suggix.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./dist/widget.js": "./dist/widget.js"
  },
  "unpkg": "./dist/widget.js",
  "jsdelivr": "./dist/widget.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "suggix",
    "widget",
    "feedback",
    "changelog",
    "feature-requests",
    "customer-feedback",
    "roadmap",
    "embed",
    "sdk"
  ],
  "author": "Suggix <support@suggix.com>",
  "license": "MIT",
  "homepage": "https://suggix.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suggix/widget.git"
  },
  "bugs": {
    "url": "https://github.com/suggix/widget/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  }
}
